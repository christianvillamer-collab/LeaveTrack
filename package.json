{
  "name": "leavetrack",
  "version": "0.1.0",
  "private": true,
  "description": "LeaveTrack — self-service leave requests, scoped manager approvals, and auditable HR records.",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/leave-request.integration.test.ts && node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/leave-balance.integration.test.ts && node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/leave-team.integration.test.ts && node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/leave-decision.integration.test.ts",
    "env:setup": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "pino": "10.4.0",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
