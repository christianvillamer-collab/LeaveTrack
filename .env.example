# ---------------------------------------------------------------------------
# LeaveTrack environment
# Copy to .env.local, or run `npm run env:setup` for local Docker defaults.
# Mock pages run without values; DB-backed pages need DATABASE_URL.
# ---------------------------------------------------------------------------

# Public origin used for absolute links and cookie `secure` decisions in prod.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# --- Database (Day 1+) ------------------------------------------------------
# Supabase POOLED connection string (port 6543, transaction mode), or the local
# Docker default created by `npm run env:setup`:
#   postgres://leavetrack:leavetrack@localhost:55432/leavetrack
# Required for DB-backed pages and `npm run db:migrate` / `npm run db:seed`.
# After the ADR-LeaveTrack-E005 cutover, point this at the least-privilege
# `leavetrack_app` role instead of the owner. The app role cannot run migrations,
# the seed, or `npm run test:db` (those need the owner and some suites write).
DATABASE_URL=""

# Direct (non-pooled) connection, port 5432. Migrations/seed/tests only. Falls
# back to DATABASE_URL when empty. Keep it on the owner: DDL needs ownership and
# the app role never holds DDL. After the cutover, the DB suites need the owner
# explicitly: `DATABASE_URL="$DIRECT_URL" npm run test:db`.
DIRECT_URL=""

# --- Supabase Auth (E2-02) --------------------------------------------------
# Required for sign-in. The URL and anon key are public client values. The anon
# key only reaches Supabase Auth: PostgREST access for anon/authenticated is
# denied at the database (ADR-LeaveTrack-E005). Sign-in fails closed when empty.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server/script only. Powers `npm run auth:seed` (local development) and must
# never be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=""

# Local development only: password applied to every seeded employee auth user.
# `npm run auth:seed` refuses to run in production unless explicitly overridden.
SEED_AUTH_PASSWORD=""

# --- Scheduled jobs (Day 1) -------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/jobs/accrual.
CRON_SECRET=""
